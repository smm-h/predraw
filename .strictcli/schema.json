{
  "schema_version": 1,
  "defaults": {
    "schema_version": 1,
    "app": {
      "env_prefix": null,
      "config": false,
      "global_flags": [],
      "commands": {},
      "groups": {},
      "deprecated": {},
      "tag_contracts": {}
    },
    "flag": {
      "short": null,
      "default": null,
      "env": null,
      "choices": null,
      "repeatable": false,
      "unique": false,
      "env_separator": null,
      "negatable": null,
      "hidden": false
    },
    "arg": {
      "type": "str",
      "required": true,
      "default": null,
      "variadic": false,
      "choices": null
    },
    "command": {
      "passthrough": false,
      "flags": [],
      "args": [],
      "tags": [],
      "constraints": [],
      "hidden": false,
      "interactive": false
    },
    "group": {
      "commands": {},
      "groups": {},
      "deprecated": {},
      "tags": [],
      "hidden": false
    }
  },
  "project_id": "predraw",
  "name": "predraw",
  "version": "0.2.1",
  "help": "predraw scene builder",
  "commands": {
    "build": {
      "name": "build",
      "help": "Build scene into output files",
      "effect": "mutating",
      "args": [
        {
          "name": "path",
          "help": "Project directory or scene file (default: .)",
          "required": false,
          "default": "."
        }
      ]
    },
    "pack": {
      "name": "pack",
      "help": "Pack a scene directory into a single JSON file",
      "effect": "mutating",
      "flags": [
        {
          "name": "output",
          "type": "str",
          "help": "Output file path (default: packed.json)",
          "short": "o",
          "default": "packed.json"
        }
      ],
      "args": [
        {
          "name": "path",
          "help": "Project directory or scene file (default: .)",
          "required": false,
          "default": "."
        }
      ]
    },
    "unpack": {
      "name": "unpack",
      "help": "Unpack a packed JSON file into a project directory",
      "effect": "mutating",
      "flags": [
        {
          "name": "output",
          "type": "str",
          "help": "Output directory (default: .)",
          "short": "o",
          "default": "."
        }
      ],
      "args": [
        {
          "name": "file",
          "help": "Packed JSON file to unpack"
        }
      ]
    },
    "init": {
      "name": "init",
      "help": "Create a starter project in a directory",
      "effect": "mutating",
      "args": [
        {
          "name": "path",
          "help": "Directory to initialize (default: .)",
          "required": false,
          "default": "."
        }
      ]
    },
    "watch": {
      "name": "watch",
      "help": "Watch project files and rebuild on change",
      "effect": "mutating",
      "args": [
        {
          "name": "path",
          "help": "Project directory (default: .)",
          "required": false,
          "default": "."
        }
      ]
    },
    "validate": {
      "name": "validate",
      "help": "Validate a scene or config JSON file against its schema",
      "effect": "read_only",
      "flags": [
        {
          "name": "schema",
          "type": "str",
          "help": "Force schema type (auto-detected if omitted)",
          "default": "",
          "choices": [
            "scene",
            "config",
            ""
          ]
        }
      ],
      "args": [
        {
          "name": "file",
          "help": "JSON file to validate"
        }
      ]
    }
  }
}
