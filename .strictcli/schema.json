  "project_id": "predraw",
  "name": "predraw",
  "version": "0.4.0",
  "help": "predraw scene builder",
  "commands": {
    "build": {
      "name": "build",
      "help": "Build scene into output files",
      "effect": "mutating",
      "args": [
        {
          "name": "path",
          "help": "Project directory or scene file. Omitted, the current directory is built.",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ]
    },
    "pack": {
      "name": "pack",
      "help": "Pack a scene directory into a single JSON file",
      "effect": "mutating",
      "flags": [
        {
          "name": "output",
          "help": "Output file path. Omitted, the scene is written to packed.json.",
          "value_schema": {
            "type": "string"
          },
          "short": "o",
          "presence": "optional"
        }
      ],
      "args": [
        {
          "name": "path",
          "help": "Project directory or scene file. Omitted, the current directory is packed.",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ]
    },
    "unpack": {
      "name": "unpack",
      "help": "Unpack a packed JSON file into a project directory",
      "effect": "mutating",
      "flags": [
        {
          "name": "output",
          "help": "Output directory. Omitted, the project is unpacked into the current directory.",
          "value_schema": {
            "type": "string"
          },
          "short": "o",
          "presence": "optional"
        }
      ],
      "args": [
        {
          "name": "file",
          "help": "Packed JSON file to unpack",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        }
      ]
    },
    "init": {
      "name": "init",
      "help": "Create a starter project in a directory",
      "effect": "mutating",
      "args": [
        {
          "name": "path",
          "help": "Directory to initialize. Omitted, the current directory is initialized.",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "help": "Watch project files and rebuild on change",
      "effect": "mutating",
      "args": [
        {
          "name": "path",
          "help": "Project directory. Omitted, the current directory is watched.",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ]
    },
    "validate": {
      "name": "validate",
      "help": "Validate a scene or config JSON file against its schema",
      "effect": "read_only",
      "flags": [
        {
          "name": "schema",
          "help": "Force the schema to validate against. Omitted, it is detected from the file.",
          "value_schema": {
            "type": "string",
            "enum": [
              "scene",
              "config"
            ]
          },
          "presence": "optional",
          "choices": [
            {
              "value": "scene",
              "help": "validate against the scene schema"
            },
            {
              "value": "config",
              "help": "validate against the output-config schema"
            }
          ]
        }
      ],
      "args": [
        {
          "name": "file",
          "help": "JSON file to validate",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        }
      ]
    }
  }
}
